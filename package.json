{
  "name": "darwin-journal",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24",
    "pnpm": "11.7.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "db:start": "tsx scripts/dev-db.ts",
    "db:migrate": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/migrate.ts",
    "db:bootstrap": "node --experimental-strip-types --env-file-if-exists=.env.local scripts/bootstrap.ts",
    "db:bootstrap:demo": "node --conditions=react-server --import tsx --env-file-if-exists=.env.local scripts/bootstrap.ts --demo",
    "site:edition": "node scripts/set-site-edition.mjs",
    "site:configure": "node scripts/site-configure.mjs",
    "backup": "scripts/backup.sh",
    "restore": "scripts/restore.sh",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@tiptap/extension-image": "3.31.3",
    "@tiptap/extension-mathematics": "3.31.3",
    "@tiptap/extension-placeholder": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "better-auth": "1.7.5",
    "drizzle-orm": "0.45.2",
    "katex": "0.18.7",
    "lucide-react": "1.47.0",
    "next": "16.3.5",
    "nodemailer": "10.0.10",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/katex": "0.16.8",
    "@types/node": "26.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "prettier": "3.9.8",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
