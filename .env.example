# Public hostname only, without a scheme. Caddy obtains and renews TLS certificates.
CADDY_SITE=journal.example.com

# PostgreSQL service credentials. Generate a unique value before deployment.
POSTGRES_DB=darwin
POSTGRES_USER=darwin
# Use a URL-safe password, or percent-encode its password component below.
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgresql://darwin:replace-with-the-same-password@db:5432/darwin

# Better Auth runtime configuration.
BETTER_AUTH_URL=https://journal.example.com
BETTER_AUTH_SECRET=replace-with-a-random-32-byte-secret
# Only during SMTP credential-key rotation; remove after saving mail settings again.
# MAIL_ENCRYPTION_PREVIOUS_SECRET=the-previous-better-auth-secret

# Canonical public URL for metadata, RSS, robots, and sitemap generation.
SITE_URL=https://journal.example.com

# Homepage visual edition. Allowed values: classic or anniversary-9.
SITE_EDITION=classic

# A base64-encoded AES key of 16, 24, or 32 bytes. Keep it stable across deploys.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Optional values for the explicit one-shot administrator bootstrap job. Omit
# them to answer the interactive prompts instead; do not keep ADMIN_PASSWORD
# in a long-lived production .env file.
# ADMIN_EMAIL=admin@example.com
# ADMIN_NAME=Darwin Administrator
# ADMIN_PASSWORD=replace-with-a-long-temporary-password

# Optional host port overrides.
HTTP_PORT=80
HTTPS_PORT=443
